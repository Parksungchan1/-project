SERVER_URL=http://localhost:3000
ADMIN_TOKEN=change-me
# Windows: 블루투스 설정 > COM 포트 탭에서 확인 (예: COM5)
# macOS: 블루투스 설정에서 페어링 후 `npm run list-ports`로 확인 (예: /dev/cu.T02-SPPDev-1)
PRINTER_COM_PORT=COM5
POLL_INTERVAL_MS=2000
# true = skip actual Bluetooth send, just log what would be printed (no printer needed)
DRY_RUN=true
